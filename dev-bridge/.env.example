# Public identifiers, not secrets.
OWNER_BRIDGE_PUBLIC_URL=https://owner-dev-bridge.example.com
OWNER_BRIDGE_OAUTH_ISSUER=https://YOUR_TENANT.auth0.com/
OWNER_BRIDGE_OAUTH_AUDIENCE=https://owner-dev-bridge.example.com/mcp
OWNER_BRIDGE_OAUTH_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
BLOB_STORE_ID=store_YOUR_PRIVATE_AUDIT_STORE_ID

# Server-side only. Use immutable identity-provider subject IDs, not emails.
OWNER_BRIDGE_ALLOWED_SUBJECTS=provider|owner-subject-id

# Install a dedicated least-privilege GitHub App on CGProductionHouse/CG-Dynamics.
OWNER_BRIDGE_GITHUB_APP_ID=
OWNER_BRIDGE_GITHUB_INSTALLATION_ID=
OWNER_BRIDGE_GITHUB_PRIVATE_KEY=

# Optional read-only Vercel and Supabase diagnostics.
OWNER_BRIDGE_VERCEL_TOKEN=
OWNER_BRIDGE_VERCEL_PROJECT_ID=
OWNER_BRIDGE_VERCEL_TEAM_ID=
OWNER_BRIDGE_SUPABASE_ACCESS_TOKEN=
OWNER_BRIDGE_SUPABASE_PROJECT_REF=ehtjfntukiwbgptqgbzy
