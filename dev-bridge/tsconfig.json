{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "test/**/*.ts", "server.ts"]
}
